<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error | Cocktail Explorer</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>

<body class="error-page">

    <nav class="navbar dark-navbar">

        <a href="/" class="logo">
            🍹 The Cocktail Cabinet
        </a>

    </nav>


    <main class="error-container">

        <div class="error-icon">
             <img src="/images/broken_glass.png" width="70" alt="broken glass">
        </div>

        <p class="eyebrow">OOPS!</p>

        <h1>
            Something went wrong.
        </h1>

        <p>
            <%= message %>
        </p>

        <a href="/" class="details-button">
            ← Back to Home
        </a>

    </main>

</body>
</html>